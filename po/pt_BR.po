#: src/index.html:20
msgid "Cockpit Sensors"
msgstr "Sensores para Cockpit"

#: src/history.ts:133
msgid "PCP is not available for $0"
msgstr "O PCP não está disponível para $0"

#: src/app.tsx:61
msgid "Enable sensor history"
msgstr "Ativar histórico dos sensores"

#: src/app.tsx:65
msgid "Sensor history is recorded with Performance Co-Pilot (PCP), the same service that powers Cockpit's Metrics and history page."
msgstr "O histórico dos sensores é gravado com o Performance Co-Pilot (PCP), o mesmo serviço usado pela página Métricas e histórico do Cockpit."

#: src/app.tsx:68
msgid "PCP packages are not available for this distribution. Install PCP and its lm-sensors agent manually."
msgstr "Os pacotes do PCP não estão disponíveis para esta distribuição. Instale o PCP e o agente lm-sensors manualmente."

#: src/app.tsx:71
msgid "This will:"
msgstr "Isso vai:"

#: src/app.tsx:75
msgid "install the packages $0, if missing"
msgstr "instalar os pacotes $0, se estiverem faltando"

#: src/app.tsx:76
msgid "install PCP, if missing"
msgstr "instalar o PCP, se estiver faltando"

#: src/app.tsx:78
msgid "enable the PCP lm-sensors agent (pmdalmsensors)"
msgstr "ativar o agente lm-sensors do PCP (pmdalmsensors)"

#: src/app.tsx:79
msgid "record all sensor readings every minute with pmlogger"
msgstr "gravar as leituras de todos os sensores a cada minuto com o pmlogger"

#: src/app.tsx:82
msgid "History is kept as long as pmlogger keeps its archives (14 days by default)."
msgstr "O histórico é mantido enquanto o pmlogger guardar seus arquivos (14 dias por padrão)."

#: src/app.tsx:87
msgid "Enabling sensor history failed"
msgstr "Falha ao ativar o histórico dos sensores"

